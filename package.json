{
  "name": "@reactvision/viro-web-renderer",
  "version": "0.0.1",
  "description": "WebAssembly/WebGL2 build of the Viro renderer (virocore) for the web platform",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ReactVision/viro-web-renderer.git"
  },
  "keywords": [
    "viro",
    "reactvision",
    "webassembly",
    "wasm",
    "webgl2",
    "3d",
    "ar"
  ],
  "files": [
    "dist",
    "wasm"
  ],
  "sideEffects": [
    "*.wasm",
    "*.data"
  ],
  "scripts": {
    "copy-wasm": "bash scripts/copy-wasm.sh",
    "build": "tsc",
    "clean": "rm -rf dist *.tgz",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
